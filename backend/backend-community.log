info: Microsoft.EntityFrameworkCore.Database.Command[20101]
      Executed DbCommand (185ms) [Parameters=[], CommandType='Text', CommandTimeout='30']
      SELECT d."Id" AS "DriverId", d."UserId", u."FirstName" || ' ' || u."LastName" AS "FullName", u."Email", u."Phone", CASE d."VehicleType"
          WHEN 0 THEN 'Motorcycle'
          WHEN 1 THEN 'Mototaxi'
          WHEN 2 THEN 'Bicycle'
          ELSE d."VehicleType"::text
      END AS "VehicleType", d."Plate", d."ZoneId", z."Name" AS "ZoneName", CASE d."ApprovalStatus"
          WHEN 0 THEN 'Pending'
          WHEN 1 THEN 'Approved'
          WHEN 2 THEN 'Rejected'
          ELSE d."ApprovalStatus"::text
      END AS "ApprovalStatus", d."IsAvailable", CASE d."TrustLevel"
          WHEN 0 THEN 'Verified'
          WHEN 1 THEN 'Trusted'
          ELSE d."TrustLevel"::text
      END AS "TrustLevel", d."CompletedDeliveriesCount", d."TrustScore", COALESCE((
          SELECT avg(o."DriverRating"::numeric)
          FROM orders AS o
          WHERE d."Id" = o."DriverId" AND o."Status" = 7 AND o."DriverRating" IS NOT NULL), 0.0) AS "AverageRating", CASE u."Status"
          WHEN 0 THEN 'Pending'
          WHEN 1 THEN 'Active'
          WHEN 2 THEN 'Suspended'
          ELSE u."Status"::text
      END AS "UserStatus", u."CreatedAtUtc"
      FROM driver_profiles AS d
      INNER JOIN users AS u ON d."UserId" = u."Id"
      INNER JOIN zones AS z ON d."ZoneId" = z."Id"
      ORDER BY u."CreatedAtUtc" DESC
